# ==============================================================================
# NEXUS FORGE Production Docker Environment Variables
# Copy to .env and configure secrets before running docker compose up
# ==============================================================================

# Server Environment
ENV=production
DEBUG=false
DEMO_MODE=true

# Sponsor API Keys
OMI_API_KEY=your_real_omi_api_key_here
LYZR_API_KEY=sk-your_real_lyzr_api_key_here
GEMINI_API_KEY=your_real_gemini_api_key_here

# Vector Database (Qdrant)
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# Security & Webhook Ingestion
WEBHOOK_SECRET_KEY=nexus-production-secret-token-min-32chars
CREDENTIAL_ENCRYPTION_KEY=nexus-production-encryption-key32b
