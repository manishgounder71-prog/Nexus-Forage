# NEXUS FORGE Backend Environment Configuration

ENV=production
SECRET_KEY=nexus-forge-secret-key-3.0
DATABASE_URL=sqlite+aiosqlite:///./nexus_forge.db
DEMO_MODE=true

# Sponsor 1: Qdrant Vector Cloud Cluster
QDRANT_URL=https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.us-west-2-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# Sponsor 2: Lyzr AI Agent Studio
LYZR_API_KEY=your_lyzr_api_key_here
LYZR_BASE_URL=https://agent-prod.studio.lyzr.ai
OPENAI_API_KEY=your_openai_api_key_here

# Sponsor 3: Omi Voice Engine / Gemini LLM
OMI_API_KEY=your_omi_api_key_here
OMI_API_URL=https://api.omi.me/v1
GEMINI_API_KEY=your_gemini_api_key_here

# Connector Security & Rate Limiting
WEBHOOK_SECRET_KEY=nexus-webhook-secret-production-key-change
CREDENTIAL_ENCRYPTION_KEY=nexus-cred-enc-key-32bytes-change!
RATE_LIMIT_PER_MINUTE=60
DEMO_ORG_ID=org_acme_digital
