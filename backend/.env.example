# NEXUS FORGE Backend Environment Configuration

ENV=development
SECRET_KEY=nexus-forge-secret-key-3.0
DATABASE_URL=sqlite+aiosqlite:///./nexus_forge.db

# Qdrant Vector Memory Configuration (Optional for cloud, defaults to in-memory)
QDRANT_URL=
QDRANT_API_KEY=

# AI Agent Framework Credentials
LYZR_API_KEY=
# Base URL for the Lyzr Agent Framework v3 API (orchestration + agent lifecycle)
LYZR_BASE_URL=https://agent-prod.studio.lyzr.ai
OPENAI_API_KEY=

DEMO_MODE=true
